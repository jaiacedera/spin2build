# Copy to .env.local for local use.
# Browser client settings. Use only a publishable key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Analytics settings.
# Property ID from the supplied Analytics URL (p553743552).
GA_PROPERTY_ID=553743552
GA_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Shared production gallery. Server-only; never use a VITE_ prefix.
# Run server/gallery-schema.sql, then server/site-usage.sql in Supabase first.
# These server settings also enable shared usage protection for /api/stats.
GALLERY_SUPABASE_URL=
GALLERY_SUPABASE_SERVICE_KEY=
# Optional persistent directory for a single Node server. Development defaults
# to .gallery-data.local; serverless production requires the database above.
GALLERY_LOCAL_DIR=
